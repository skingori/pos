# Local Docker Postgres (docker compose → port 5433). For Neon demo, use pooled + direct URLs.
DATABASE_URL="postgresql://pos:pos@localhost:5433/kenya_hardware_pos?schema=public"
# Same as DATABASE_URL locally. On Neon/Vercel: use the non-pooler "direct" connection string.
DIRECT_URL="postgresql://pos:pos@localhost:5433/kenya_hardware_pos?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-use-openssl-rand-base64-32"
SHOP_NAME="Kenya Hardware"
NEXT_PUBLIC_SHOP_NAME="Kenya Hardware"
NODE_ENV=development
# ALLOW_SEED=1

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_ENV=sandbox
